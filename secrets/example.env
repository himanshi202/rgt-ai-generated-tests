# Template for a per-client execution-credentials file.
#
# Copy this to secrets/<client_id>.env (e.g. secrets/test-ai.env) and fill in
# real values. That file is gitignored -- it never gets committed. Real
# values only ever live here (local, your machine) and in GitHub's encrypted
# Actions secrets, pushed via scripts/push-client-secrets.sh -- never in git
# history.
#
# BASE_URL       real staging/test URL for this client's app
# TEST_USERNAME  a real test account username that exists there
# TEST_PASSWORD  its password

BASE_URL=
TEST_USERNAME=
TEST_PASSWORD=
