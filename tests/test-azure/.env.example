# Template for this client's real execution credentials.
#
# Copy this file to ".env" in this SAME folder and fill in real values.
# ".env" here is gitignored -- it never gets committed. Real values only
# ever live here (local, your machine) and in GitHub's encrypted Actions
# secrets, pushed via scripts/push-client-secrets.sh -- never in git
# history.
#
# BASE_URL       real staging/test URL for this client's app
# TEST_USERNAME  a real test account username that exists there
# TEST_PASSWORD  its password

BASE_URL=
TEST_USERNAME=
TEST_PASSWORD=
